# --- Build output -------------------------------------------------------------
backend/target/
backend/target_*/
frontend/dist/

# --- Dependencies -----------------------------------------------------------
node_modules/

# --- Runtime uploads (user-generated binaries, regenerated at runtime) --------
/uploads/
backend/uploads/

# --- Logs -------------------------------------------------------------------
*.log
npm-debug.log*

# --- Local environment / secrets ------------------------------------------
.env
.env.*
!.env.example
backend/.env
*.local
# Spring profile files that carry real credentials (kept out of VCS)
application-local.yml
application-*-local.yml
src/main/resources/application-secret*.yml

# --- IDE / OS -------------------------------------------------------------------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# --- LaTeX (fichiers auxiliaires) ------------------------------------------
docs/report/*.aux
docs/report/*.log
docs/report/*.out
docs/report/*.toc
docs/report/*.lof
docs/report/*.lot
docs/report/*.synctex.gz
# Caches de compilation latexmk/pdflatex (chemins absolus de la machine de build)
docs/report/*.fdb_latexmk
docs/report/*.fls

# --- Fichiers verrous Office (crees a l'ouverture d'un .pptx / .docx) --------
~$*
