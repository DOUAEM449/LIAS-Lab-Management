# LIAS backend — environment template.
# Copy to `backend/.env` and fill in real values. `backend/.env` is git-ignored.
# Spring Boot loads it automatically (spring.config.import in application.yml)
# when the app is started from the `backend/` directory; in CI / production,
# set these as real environment variables instead.

# --- Database (PostgreSQL / Neon) --------------------------------------------
DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_NAME=lias_lab_db
DB_USERNAME=lias_app
DB_PASSWORD=change-me

# --- Outgoing mail (SMTP) ---------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change-me

# --- Security --------------------------------------------------------------
# Base64-encoded signing key, >= 64 bytes once decoded (HS512).
# Generate: openssl rand -base64 72
JWT_SECRET=generate-a-strong-base64-secret

# --- File storage --------------------------------------------------------------
# Absolute path recommended so uploads do not depend on the working directory.
FILE_STORAGE_DIR=./uploads

# --- Optional overrides (have sane defaults in application.yml) ---------------
# SERVER_PORT=8080
# CORS_ORIGINS=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# REPORTS_ANNUAL_CRON=0 0 2 1 1 *
# REPORTS_ANNUAL_ZONE=Africa/Casablanca
